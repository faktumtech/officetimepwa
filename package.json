    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.3",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-plugin-vuetify": "^2.1.0",
    "globals": "^17.0.0",
    "sass": "^1.97.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue-eslint-parser": "^10.2.0"
